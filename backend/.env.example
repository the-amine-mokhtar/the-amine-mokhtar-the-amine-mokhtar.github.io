# Copy the values you need into your host's environment settings
# (Render dashboard, docker-compose.yml, or your shell). All are optional.

# Port the server listens on. Most hosts set this for you.
PORT=8080

# Origins allowed to call the API, comma-separated. "*" allows any site.
# In production, set it to your GitHub Pages origin (no path, no trailing slash).
ALLOWED_ORIGINS=https://the-amine-mokhtar.github.io

# GitHub account shown in the "Live from GitHub" section.
# Defaults to profile.github in frontend/data/content.json.
GITHUB_USERNAME=the-amine-mokhtar

# Optional personal access token (no scopes needed for public data).
# Raises the GitHub API limit from 60 to 5,000 requests per hour. Never commit it.
GITHUB_TOKEN=

# How long GitHub data is cached, in seconds.
GITHUB_CACHE_SECONDS=600

# Set to false to run as a pure API without serving the frontend files.
SERVE_STATIC=true
